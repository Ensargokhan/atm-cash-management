              "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
              "",
              "pm.test(\"Error code\", () => pm.expect(pm.response.json().errorCode).to.eql(\"RECONCILIATION_AWAITING_APPROVAL\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Approve by the same user is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User",
            "value": "alice"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reconciliations/{{reconciliationId}}/approve",
