{
  "info": {
    "_postman_id": "c6c966a3-7330-5312-a214-f57080b3e14a",
    "name": "ATM Cash Management - End to end",
    "description": "Run in order (Collection Runner or newman): create ATM -> configure cassettes -> load cash -> put in service -> request quote -> confirm -> deposit -> switch to maintenance -> reconcile -> report. Extra steps show the idempotent replay and the four-eyes approval.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Create ATM",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{atmCode}}\",\n  \"name\": \"Kadikoy Branch\",\n  \"location\": \"Istanbul\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"atmCode\", \"ATM-\" + Date.now());",
              "// A fresh card per run keeps the daily limit from blocking repeated runs.",
              "let card = \"4\"; for (let i = 0; i < 15; i++) card += Math.floor(Math.random() * 10);",
              "pm.collectionVariables.set(\"cardNumber\", card);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "",
              "const atm = pm.response.json();",
              "pm.test(\"ATM starts UNCONFIGURED\", () => pm.expect(atm.status).to.eql(\"Unconfigured\"));",
              "pm.collectionVariables.set(\"atmId\", atm.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Configure cassettes",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "ops.supervisor"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/cassettes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms",
            "{{atmId}}",
            "cassettes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cassettes\": [\n    {\n      \"slot\": 1,\n      \"type\": \"Recycling\",\n      \"currency\": \"TRY\",\n      \"denomination\": 100\n    },\n    {\n      \"slot\": 2,\n      \"type\": \"Recycling\",\n      \"currency\": \"TRY\",\n      \"denomination\": 50\n    },\n    {\n      \"slot\": 3,\n      \"type\": \"Recycling\",\n      \"currency\": \"TRY\",\n      \"denomination\": 20\n    },\n    {\n      \"slot\": 4,\n      \"type\": \"Recycling\",\n      \"currency\": \"USD\",\n      \"denomination\": 100\n    },\n    {\n      \"slot\": 5,\n      \"type\": \"Deposit\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"ATM is CONFIGURED\", () => pm.expect(pm.response.json().status).to.eql(\"Configured\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Load cash",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "ops.loader"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/cash-loads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms",
            "{{atmId}}",
            "cash-loads"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"slot\": 1,\n      \"count\": 50\n    },\n    {\n      \"slot\": 2,\n      \"count\": 40\n    },\n    {\n      \"slot\": 3,\n      \"count\": 100\n    },\n    {\n      \"slot\": 4,\n      \"count\": 20\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "const atm = pm.response.json();",
              "pm.test(\"ATM is LOADED\", () => pm.expect(atm.status).to.eql(\"Loaded\"));",
              "pm.test(\"TRY balance is 9,000\", () => pm.expect(atm.balances.find(b => b.currency === \"TRY\").totalAmount).to.eql(9000));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Put in service",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User",
            "value": "ops.supervisor"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/put-in-service",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms",
            "{{atmId}}",
            "put-in-service"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"ATM is IN_SERVICE\", () => pm.expect(pm.response.json().status).to.eql(\"InService\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Request withdrawal quote",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/withdrawal-quotes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms",
            "{{atmId}}",
            "withdrawal-quotes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cardNumber\": \"{{cardNumber}}\",\n  \"currency\": \"TRY\",\n  \"amount\": 1160\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "",
              "const quote = pm.response.json();",
              "pm.test(\"Exact match with the fewest notes\", () => {",
              "    pm.expect(quote.isExactMatch).to.be.true;",
              "    pm.expect(quote.options[0].notes).to.eql([{ denomination: 100, count: 11 }, { denomination: 20, count: 3 }]);",
              "});",
              "pm.collectionVariables.set(\"quoteId\", quote.quoteId);",
              "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Confirm quote",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/withdrawal-quotes/{{quoteId}}/confirm",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "withdrawal-quotes",
            "{{quoteId}}",
            "confirm"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"option\": \"Exact\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "const result = pm.response.json();",
              "pm.test(\"1,160 TRY dispensed\", () => pm.expect(result.dispensedAmount).to.eql(1160));",
              "pm.collectionVariables.set(\"confirmedAt\", result.confirmedAt);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Confirm again with the same Idempotency-Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/withdrawal-quotes/{{quoteId}}/confirm",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "withdrawal-quotes",
            "{{quoteId}}",
            "confirm"
          ]
        },
        "description": "Retry of the previous request: returns the stored result, cash is not debited twice.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"option\": \"Exact\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Same result is replayed\", () => pm.expect(pm.response.json().confirmedAt).to.eql(pm.collectionVariables.get(\"confirmedAt\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Deposit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/deposits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms",
            "{{atmId}}",
            "deposits"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": [\n    {\n      \"currency\": \"TRY\",\n      \"denomination\": 100,\n      \"count\": 5\n    },\n    {\n      \"currency\": \"TRY\",\n      \"denomination\": 500,\n      \"count\": 2\n    },\n    {\n      \"currency\": \"EUR\",\n      \"denomination\": 50,\n      \"count\": 3\n    }\n  ],\n  \"unrecognizedCount\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "const deposit = pm.response.json();",
              "pm.test(\"TRY 100 goes to its recycling cassette\", () =>",
              "    pm.expect(deposit.accepted.find(a => a.denomination === 100).slot).to.eql(1));",
              "pm.test(\"Notes without a recycling cassette go to the deposit cassette\", () =>",
              "    pm.expect(deposit.accepted.filter(a => a.cassetteType === \"Deposit\").length).to.eql(2));",
              "pm.test(\"Unrecognised note is returned\", () =>",
              "    pm.expect(deposit.returned).to.deep.include({ currency: null, denomination: null, count: 1, reason: \"Unrecognized\" }));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Switch to maintenance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User",
            "value": "ops.supervisor"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/maintenance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms",
            "{{atmId}}",
            "maintenance"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "const atm = pm.response.json();",
              "pm.test(\"ATM is in MAINTENANCE\", () => pm.expect(atm.status).to.eql(\"Maintenance\"));",
              "// Prepare the manual count: everything matches except one TRY 100 note (100 TRY, under the approval threshold).",
              "const counts = atm.cassettes.flatMap(c => c.type === \"Recycling\"",
              "    ? [{ slot: c.slot, count: c.slot === 1 ? c.count - 1 : c.count }]",
              "    : c.contents.map(n => ({ slot: c.slot, currency: n.currency, denomination: n.denomination, count: n.count })));",
              "pm.collectionVariables.set(\"reconcileCounts\", JSON.stringify({ counts }, null, 2));",
              "// Second count for the four-eyes demo: 20 more TRY 100 notes missing (2,000 TRY).",
              "const bigCounts = counts.map(c => c.slot === 1 ? Object.assign({}, c, { count: c.count - 20 }) : c);",
              "pm.collectionVariables.set(\"reconcileCountsLarge\", JSON.stringify({ counts: bigCounts }, null, 2));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Reconcile (small difference, applied)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "alice"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/reconciliations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms",
            "{{atmId}}",
            "reconciliations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{reconcileCounts}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "",
              "const r = pm.response.json();",
              "pm.test(\"Applied immediately (100 TRY <= 1,000 TRY)\", () => {",
              "    pm.expect(r.status).to.eql(\"Applied\");",
              "    pm.expect(r.totalDifferenceTry).to.eql(100);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Reconcile (large difference, needs approval)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "alice"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/reconciliations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms",
            "{{atmId}}",
            "reconciliations"
          ]
        },
        "description": "The first count was applied, so this count is 20 TRY 100 notes short of the new system figures (2,000 TRY).",
        "body": {
          "mode": "raw",
          "raw": "{{reconcileCountsLarge}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "",
              "const r = pm.response.json();",
              "pm.test(\"Awaiting four-eyes approval\", () => pm.expect(r.status).to.eql(\"AwaitingApproval\"));",
              "pm.collectionVariables.set(\"reconciliationId\", r.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Put in service is blocked while awaiting approval",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User",
            "value": "ops.supervisor"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms/{{atmId}}/put-in-service",
          "host": [
